# Plantilla. El secreto real se crea con kubectl y NO se versiona:
#
#   kubectl create secret generic jenkins-secrets -n alumno-team1 \
#     --from-literal=JENKINS_ADMIN_USER=admin \
#     --from-literal=JENKINS_ADMIN_PASSWORD='<una-clave>' \
#     --from-literal=DOCKERHUB_USER=rperdomo4 \
#     --from-literal=DOCKERHUB_TOKEN='<token-de-docker-hub>'
apiVersion: v1
kind: Secret
metadata:
  name: jenkins-secrets
type: Opaque
stringData:
  JENKINS_ADMIN_USER: admin
  JENKINS_ADMIN_PASSWORD: cambiar
  DOCKERHUB_USER: tu-usuario
  DOCKERHUB_TOKEN: cambiar
